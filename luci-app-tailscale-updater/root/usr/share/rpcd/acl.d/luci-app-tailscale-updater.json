{
	"luci-app-tailscale-updater": {
		"description": "允许访问 iStoreOS Tailscale 更新工具",
		"read": {
			"file": {
				"/usr/libexec/tailscale-update": [ "list", "exec" ],
				"/tmp/tailscale-update.log": [ "read" ],
				"/tmp/tailscale-update.rc": [ "read" ],
				"/tmp/tailscale-update.status": [ "read" ]
			}
		},
		"write": {
			"file": {
				"/usr/libexec/tailscale-update": [ "exec" ],
				"/tmp/tailscale-update.log": [ "write" ],
				"/tmp/tailscale-update.rc": [ "write" ],
				"/tmp/tailscale-update.status": [ "write" ]
			}
		}
	}
}
